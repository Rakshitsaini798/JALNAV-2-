PORT=3000
DATABASE_URL="postgresql://postgres:password@localhost:5432/jalnavigator?schema=public"

# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to true to print every SQL query Prisma runs
PRISMA_LOG_QUERIES=false
